# --- Приложение ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Публичный адрес, с которого пользователь открывает сайт.
# В dev это Vite (он проксирует /api на сервер), в проде — адрес приложения.
# В проде из него же Caddy берёт имя сайта и выпускает сертификат, поэтому схема
# должна быть https, а адрес — без завершающего слэша.
APP_BASE_URL=http://localhost:5173

# --- База данных ---
# Учётные данные Postgres. В проде обязательно смените пароль: docker-compose
# поднимает базу с этими значениями и собирает из них DATABASE_URL для контейнера.
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=monitoring
POSTGRES_DB=monitoring
# Строка подключения для запуска вне контейнера (npm run dev, миграции, тесты).
DATABASE_URL=postgres://monitoring:monitoring@localhost:5432/monitoring

# --- Аутентификация ---
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
# Email, который будет создан как admin при `npm run db:seed`
ADMIN_EMAIL=

# --- Почта (magic-link) ---
# console — ссылка печатается в лог сервера (разработка, первый вход).
# resend  — письмо уходит через REST API https://resend.com
EMAIL_PROVIDER=console
# Домен адреса должен быть подтверждён в панели Resend.
EMAIL_FROM=monitoring@localhost
# Ключ с https://resend.com/api-keys — обязателен при EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# --- Планировщик и раннер ---
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=5000
SCHEDULER_BATCH_SIZE=50
MAX_CONCURRENT_CHECKS=20
MAX_RESPONSE_BYTES=1048576

# --- Хранение истории ---
RAW_RETENTION_DAYS=30

# --- TLS ---
TLS_CHECK_INTERVAL_HOURS=12
TLS_WARN_DAYS=14

# Сколько запросов magic-link в час допускается с одного IP
AUTH_IP_RATE_LIMIT=20

# На каком адресе слушает контейнер приложения.
# 127.0.0.1 — наружу его публикует reverse proxy; 0.0.0.0 — открыть порт всем.
APP_BIND=127.0.0.1
