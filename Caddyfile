# Адрес берётся из APP_BASE_URL — той же переменной, которой пользуется приложение.
# Так публичный адрес задан ровно в одном месте и не может разойтись с тем, что
# приложение подставляет в ссылки для входа и проверяет в заголовке Origin.
{$APP_BASE_URL} {
	encode zstd gzip

	# Caddy сам проставляет X-Forwarded-For и X-Forwarded-Proto — по ним работают
	# лимит запросов ссылок входа и признак защищённого соединения.
	reverse_proxy app:3000
}
